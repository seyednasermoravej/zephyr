};

&pinctrl {
        ledc0_default: ledc0_default {
                group1 {
                        pinmux = <LEDC_CH0_GPIO2>,
				 <LEDC_CH0_GPIO3>,
				 <LEDC_CH0_GPIO4>,
				 <LEDC_CH0_GPIO5>,
				 <LEDC_CH0_GPIO6>,
				 <LEDC_CH0_GPIO7>,
				 <LEDC_CH0_GPIO8>;
				//  <LEDC_CH0_GPIO9>,
				//  <LEDC_CH0_GPIO10>,
				//  <LEDC_CH0_GPIO11>;
                        output-enable;
                };
        };
};

&ledc0 {
        pinctrl-0 = <&ledc0_default>;
        pinctrl-names = "default";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        channel0@0 {
                reg = <0x0>;
                timer = <0>;
        };
        channel1@1 {
                reg = <0x1>;
                timer = <0>;
        };
        channel2@2 {
                reg = <0x2>;
                timer = <0>;
        };
        channel3@3 {
                reg = <0x3>;
                timer = <0>;
        };
        channel4@4 {
                reg = <0x4>;
                timer = <0>;
        };
        channel5@5 {
                reg = <0x5>;
                timer = <0>;
        };
        channel6@6 {
                reg = <0x6>;
                timer = <0>;
        };
        channel7@7 {
                reg = <0x7>;
                timer = <0>;
        };
        channel8@8 {
                reg = <0x8>;
                timer = <0>;
        };
        channel9@9 {
                reg = <0x9>;
                timer = <0>;
        };
};

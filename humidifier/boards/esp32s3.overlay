#include <zephyr/dt-bindings/pwm/pwm.h>

/ {

	all_pwms
	{
		compatible = "pwm-leds";

		fan
		{
			pwms = <&ledc0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		piezo_piezo: piezo_piezo
		{
			pwms = <&ledc0 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		piezo0led_red{
			pwms = <&ledc0 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		piezo0led_green{
			pwms = <&ledc0 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		piezo0led_blue{
			pwms = <&ledc0 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		piezo1led_red{
			pwms = <&ledc0 5 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		piezo1led_green{
			pwms = <&ledc0 6 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		piezo1led_blue{
			pwms = <&ledc0 7 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		// piezo2led_red{
		// 	pwms = <&ledc0 8 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		// };
		// piezo2led_green{
		// 	pwms = <&ledc0 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		// };
		// piezo2led_blue{
		// 	pwms = <&ledc0 10 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		// };
	};


};



	// cdc_ncm_eth0: cdc_ncm_eth0 {
	// 	compatible = "zephyr,cdc-ncm-ethernet";
	// 	remote-mac-address = "00005E005301";
	// };

&pinctrl {
        ledc0_default: ledc0_default {
                group1 {
                        pinmux = <LEDC_CH0_GPIO1>,
				 <LEDC_CH1_GPIO2>,
				 <LEDC_CH2_GPIO3>,
				 <LEDC_CH3_GPIO4>,
				 <LEDC_CH4_GPIO5>,
				 <LEDC_CH5_GPIO6>,
				 <LEDC_CH6_GPIO7>,
				 <LEDC_CH7_GPIO8>;
				//  <LEDC_CH8_GPIO9>,
				//  <LEDC_CH9_GPIO10>;
                        output-enable;
                };
        };
};

&ledc0 {
        pinctrl-0 = <&ledc0_default>;
        pinctrl-names = "default";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        channel0@0 {
                reg = <0x0>;
                timer = <0>;
        };
        channel1@1 {
                reg = <0x1>;
                timer = <0>;
        };
        channel2@2 {
                reg = <0x2>;
                timer = <0>;
        };
        channel3@3 {
                reg = <0x3>;
                timer = <0>;
        };
        channel4@4 {
                reg = <0x4>;
                timer = <0>;
        };
        channel5@5 {
                reg = <0x5>;
                timer = <0>;
        };
        channel6@6 {
                reg = <0x6>;
                timer = <0>;
        };
        channel7@7 {
                reg = <0x7>;
                timer = <0>;
        };
        channel8@8 {
                reg = <0x8>;
                timer = <0>;
        };
        channel9@9 {
                reg = <0x9>;
                timer = <0>;
        };
        channel10@a {
                reg = <0xa>;
                timer = <0>;
        };
        channel9@b {
                reg = <0xb>;
                timer = <0>;
        };
};
&wifi{
	status = "okay";
};
